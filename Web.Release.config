<?xml version="1.0" encoding="utf-8"?>
<!-- Apply to MindWell\Web.config; the legacy Web Forms project is nested below this solution folder. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <compilation xdt:Transform="SetAttributes(debug)" debug="false" />
    <httpCookies xdt:Transform="SetAttributes(requireSSL)" requireSSL="true" />
    <authentication mode="Forms">
      <forms xdt:Transform="SetAttributes(requireSSL)" requireSSL="true" />
    </authentication>
    <customErrors xdt:Transform="SetAttributes(mode)" mode="On" />
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Content-Security-Policy"
             xdt:Locator="Match(name)"
             xdt:Transform="SetAttributes(value)"
             value="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
